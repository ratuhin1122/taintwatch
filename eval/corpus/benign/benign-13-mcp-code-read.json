{
  "schema_version": 1,
  "id": "benign-13-mcp-code-read",
  "category": "mcp-workflow",
  "description": "Inspect normal source after an MCP search result.",
  "provenance": {
    "kind": "original",
    "author": "Taintwatch contributors",
    "source": "Original synthetic scenario written for the Taintwatch M3.1 review batch; not a live capture.",
