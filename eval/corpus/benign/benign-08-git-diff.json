        "session_id": "benign-08-git-diff",
        "cwd": "/workspace/project",
        "hook_event_name": "PreToolUse",
        "tool_use_id": "benign-08-git-diff-2",
        "tool_name": "Bash",
        "tool_input": {
          "command": "git diff -- src/main.go"
        }
      },
      "expect": {
